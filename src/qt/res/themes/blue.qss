/* Curecoin Blue
   Deep blue shell with cyan CureCoin accents. The overview logo area stays
   on a darker navy panel so the existing blue wallet image remains visible. */

QWidget {
    background-color: #0d2538;
    color: #edf7ff;
    selection-background-color: #28b7ff;
    selection-color: #06121d;
}

QMainWindow,
QDialog,
QMenuBar,
QMenu,
QStatusBar,
QToolBar {
    background-color: #0d2538;
    color: #edf7ff;
}

QMenuBar::item {
    background: transparent;
    padding: 6px 10px;
}

QMenuBar::item:selected,
QMenu::item:selected {
    background-color: #143d5d;
    color: #ffffff;
}

QMenu {
    border: 1px solid #2d6f99;
    border-radius: 6px;
    padding: 4px;
}

QMenu::item {
    padding: 6px 24px 6px 24px;
}

QToolBar {
    border: 0;
    spacing: 6px;
    padding: 6px;
}

QStatusBar {
    border-top: 1px solid #1e5578;
}

QFrame#overviewWalletFrame,
QFrame#overviewRecentFrame,
QFrame[frameShape="6"] {
    background-color: #102f49;
    border: 1px solid #2d6f99;
    border-radius: 8px;
}

QLabel {
    background: transparent;
}

QLabel#label_wallet_bgcoin {
    background-color: #091927;
    border-radius: 8px;
    padding: 8px;
}

QLabel#labelWalletStatus,
QLabel#labelTransactionsStatus,
QLabel#statusLabel {
    color: #ff7878;
}

QLabel#labelBalance,
QLabel#labelStake,
QLabel#labelUnconfirmed,
QLabel#labelImmature,
QLabel#labelNumTransactions {
    color: #ffffff;
    font-family: "Cascadia Mono", "Consolas", "Monospace";
}

QPushButton,
QToolButton {
    background-color: #123a59;
    border: 1px solid #2d6f99;
    border-radius: 6px;
    color: #edf7ff;
    padding: 7px 12px;
}

QPushButton:hover,
QToolButton:hover {
    background-color: #184b70;
    border-color: #28b7ff;
}

QPushButton:pressed,
QToolButton:pressed {
    background-color: #0f324d;
}

QPushButton:disabled,
QToolButton:disabled {
    background-color: #0f2a40;
    color: #7fa2bb;
    border-color: #1e5578;
}

QLineEdit,
QComboBox,
QAbstractSpinBox,
QDateTimeEdit {
    background-color: #071725;
    border: 1px solid #2d6f99;
    border-radius: 6px;
    color: #edf7ff;
    padding: 6px 8px;
    selection-background-color: #28b7ff;
    selection-color: #06121d;
}

QLineEdit:focus,
QComboBox:focus,
QAbstractSpinBox:focus,
QDateTimeEdit:focus {
    border-color: #49c4ff;
}

QComboBox::drop-down,
QDateTimeEdit::drop-down {
    border: 0;
    width: 24px;
}

QComboBox QAbstractItemView {
    background-color: #102f49;
    border: 1px solid #2d6f99;
    selection-background-color: #28b7ff;
    selection-color: #06121d;
}

QCheckBox,
QRadioButton {
    spacing: 8px;
}

QTabWidget::pane {
    border: 1px solid #2d6f99;
    border-radius: 8px;
    top: -1px;
}

QTabBar::tab {
    background-color: #102f49;
    border: 1px solid #1e5578;
    border-bottom-color: #2d6f99;
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    padding: 7px 12px;
    margin-right: 2px;
}

QTabBar::tab:selected {
    background-color: #184b70;
    border-color: #28b7ff;
    color: #ffffff;
}

QTableView,
QTreeView,
QListView {
    background-color: #091927;
    alternate-background-color: #0f2a40;
    border: 1px solid #1e5578;
    border-radius: 8px;
    color: #edf7ff;
    gridline-color: #1e5578;
}

QListView {
    padding: 6px;
}

QListView::item {
    border-radius: 6px;
    padding: 8px 10px;
}

QListView::item:hover {
    background-color: #123a59;
}

QTableView::item {
    padding: 7px 8px;
}

QTableView::item:selected,
QListView::item:selected {
    background-color: #28b7ff;
    color: #06121d;
}

QHeaderView::section {
    background-color: #102f49;
    border: 0;
    border-right: 1px solid #1e5578;
    border-bottom: 1px solid #1e5578;
    color: #edf7ff;
    padding: 7px 8px;
}

QScrollBar:vertical,
QScrollBar:horizontal {
    background: #071725;
    border: 0;
    margin: 0;
}

QScrollBar:vertical {
    width: 12px;
}

QScrollBar:horizontal {
    height: 12px;
}

QScrollBar::handle {
    background: #2d6f99;
    border-radius: 6px;
    min-height: 28px;
    min-width: 28px;
}

QScrollBar::handle:hover {
    background: #3f8fbd;
}

QScrollBar::add-line,
QScrollBar::sub-line,
QScrollBar::add-page,
QScrollBar::sub-page {
    background: transparent;
    border: 0;
}

QProgressBar {
    background-color: #071725;
    border: 1px solid #2d6f99;
    border-radius: 7px;
    color: #edf7ff;
    padding: 1px;
    text-align: center;
}

QProgressBar::chunk {
    background-color: #28b7ff;
    border-radius: 6px;
}
