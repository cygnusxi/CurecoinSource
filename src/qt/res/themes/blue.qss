/* Curecoin Blue
   Deep blue shell with cyan CureCoin accents. The overview logo area stays
   on a darker navy panel so the existing blue wallet image remains visible. */

QWidget {
    background-color: #0d2538;
    color: #edf7ff;
    selection-background-color: #28b7ff;
    selection-color: #06121d;
}

QMainWindow,
QDialog,
QMenuBar,
QMenu,
QStatusBar,
QToolBar {
    background-color: #0d2538;
    color: #edf7ff;
}

QMenuBar::item {
    background: transparent;
    padding: 6px 10px;
}

QMenuBar::item:selected,
QMenu::item:selected {
    background-color: #143d5d;
    color: #ffffff;
}

QMenu {
    border: 1px solid #2d6f99;
    border-radius: 6px;
    padding: 4px;
}

QMenu::item {
    padding: 6px 24px 6px 24px;
}

QToolBar {
    border: 0;
    spacing: 6px;
    padding: 6px;
}

QToolBar QToolButton {
    margin: 2px;
    min-height: 34px;
}

QToolBar QToolButton:checked {
    background-color: #0f4a72;
    border-color: #28b7ff;
    color: #ffffff;
}

QToolBar QToolButton:checked:hover {
    background-color: #155d8e;
}

QStatusBar {
    border-top: 1px solid #1e5578;
}

QLabel#statusPillOk,
QLabel#statusPillWarning,
QLabel#statusPillNeutral {
    border-radius: 9px;
    font-weight: bold;
    padding: 3px 8px;
}

QLabel#statusPillOk {
    background-color: #0c302d;
    border: 1px solid #40e6a5;
    color: #a5ffd8;
}

QLabel#statusPillWarning {
    background-color: #302915;
    border: 1px solid #e5b84c;
    color: #ffdb8a;
}

QLabel#statusPillNeutral {
    background-color: #0d2d45;
    border: 1px solid #2d6f99;
    color: #c2deee;
}

QFrame#overviewWalletFrame,
QFrame#overviewRecentFrame,
QFrame[frameShape="6"] {
    background-color: #102f49;
    border: 1px solid #2d6f99;
    border-radius: 8px;
}

QFrame#overviewHeroFrame {
    background: qlineargradient(x1: 0, y1: 0, x2: 1, y2: 1,
                                stop: 0 #061828, stop: 0.5 #0d3554, stop: 1 #071421);
    border: 1px solid #28b7ff;
    border-radius: 10px;
}

QFrame#overviewMetricCard {
    background-color: #071f33;
    border: 1px solid #2d6f99;
    border-radius: 8px;
}

QWidget#overviewNetworkPanel {
    background-color: #061827;
    border: 1px solid #28b7ff;
    border-radius: 10px;
}

QLabel {
    background: transparent;
}

QLabel#label_wallet_bgcoin {
    background-color: #091927;
    border-radius: 8px;
    padding: 8px;
}

QLabel#overviewHeroEyebrow {
    color: #85dcff;
    font-weight: bold;
    letter-spacing: 1px;
}

QLabel#overviewHeroCaption,
QLabel#overviewMetricTitle {
    color: #a9cee4;
}

QLabel#overviewHeroBalance {
    color: #ffffff;
    font-family: "Cascadia Mono", "Consolas", "Monospace";
}

QLabel#overviewHeroSubtitle {
    color: #c2deee;
}

QLabel#overviewMetricValue {
    color: #ffffff;
    font-family: "Cascadia Mono", "Consolas", "Monospace";
}

QLabel#overviewHeroStatusWarning,
QLabel#overviewHeroStatusInfo,
QLabel#overviewHeroStatusOk {
    border-radius: 10px;
    font-weight: bold;
    padding: 4px 10px;
}

QLabel#overviewHeroStatusWarning {
    background-color: #2d1d25;
    border: 1px solid #ff7878;
    color: #ffaaaa;
}

QLabel#overviewHeroStatusInfo {
    background-color: #0a2e47;
    border: 1px solid #28b7ff;
    color: #a8e8ff;
}

QLabel#overviewHeroStatusOk {
    background-color: #0c302d;
    border: 1px solid #40e6a5;
    color: #a5ffd8;
}

QLabel#overviewEmptyState {
    background-color: #071f33;
    border: 1px dashed #2d6f99;
    border-radius: 8px;
    color: #a9cee4;
    padding: 28px;
}

QLabel#labelWalletStatus,
QLabel#labelTransactionsStatus,
QLabel#statusLabel {
    color: #ff7878;
}

QLabel#labelBalance,
QLabel#labelStake,
QLabel#labelUnconfirmed,
QLabel#labelImmature,
QLabel#labelNumTransactions {
    color: #ffffff;
    font-family: "Cascadia Mono", "Consolas", "Monospace";
}

QPushButton,
QToolButton {
    background-color: #123a59;
    border: 1px solid #2d6f99;
    border-radius: 6px;
    color: #edf7ff;
    padding: 7px 12px;
}

QPushButton:hover,
QToolButton:hover {
    background-color: #184b70;
    border-color: #28b7ff;
}

QPushButton:pressed,
QToolButton:pressed {
    background-color: #0f324d;
}

QPushButton:disabled,
QToolButton:disabled {
    background-color: #0f2a40;
    color: #7fa2bb;
    border-color: #1e5578;
}

QLineEdit,
QComboBox,
QAbstractSpinBox,
QDateTimeEdit {
    background-color: #071725;
    border: 1px solid #2d6f99;
    border-radius: 6px;
    color: #edf7ff;
    padding: 6px 8px;
    selection-background-color: #28b7ff;
    selection-color: #06121d;
}

QLineEdit:focus,
QComboBox:focus,
QAbstractSpinBox:focus,
QDateTimeEdit:focus {
    border-color: #49c4ff;
}

QScrollArea {
    background-color: #091927;
    border: 1px solid #1e5578;
    border-radius: 8px;
}

QScrollArea > QWidget > QWidget {
    background-color: transparent;
}

QDialog#SendCoinsDialog,
QWidget#AddressBookPage {
    background-color: #0d2538;
}

QWidget#AddressBookPage QLabel#labelExplanation {
    background-color: #071f33;
    border: 1px solid #2d6f99;
    border-radius: 8px;
    color: #c2deee;
    padding: 12px;
}

QWidget#AddressBookPage QPushButton {
    min-height: 28px;
}

QDialog#SendCoinsDialog QLabel#labelBalance {
    color: #ffffff;
    font-family: "Cascadia Mono", "Consolas", "Monospace";
    font-weight: bold;
}

QDialog#SendCoinsDialog QPushButton#sendButton {
    background-color: #0f69a0;
    border-color: #28b7ff;
    color: #ffffff;
    font-weight: bold;
    min-height: 30px;
}

QDialog#SendCoinsDialog QPushButton#sendButton:hover {
    background-color: #1283c9;
}

QFrame#SendCoinsEntry {
    background-color: #071f33;
    border: 1px solid #2d6f99;
    border-radius: 8px;
}

QFrame#SendCoinsEntry QLabel {
    color: #c2deee;
}

QFrame#SendCoinsEntry QToolButton {
    min-width: 28px;
    padding: 5px;
}

QComboBox::drop-down,
QDateTimeEdit::drop-down {
    border: 0;
    width: 24px;
}

QComboBox QAbstractItemView {
    background-color: #102f49;
    border: 1px solid #2d6f99;
    selection-background-color: #28b7ff;
    selection-color: #06121d;
}

QCheckBox,
QRadioButton {
    spacing: 8px;
}

QTabWidget::pane {
    border: 1px solid #2d6f99;
    border-radius: 8px;
    top: -1px;
}

QTabBar::tab {
    background-color: #102f49;
    border: 1px solid #1e5578;
    border-bottom-color: #2d6f99;
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    padding: 7px 12px;
    margin-right: 2px;
}

QTabBar::tab:selected {
    background-color: #184b70;
    border-color: #28b7ff;
    color: #ffffff;
}

QTableView,
QTreeView,
QListView {
    background-color: #091927;
    alternate-background-color: #0f2a40;
    border: 1px solid #1e5578;
    border-radius: 8px;
    color: #edf7ff;
    gridline-color: #1e5578;
}

QListView {
    padding: 6px;
}

QListView::item {
    border-radius: 6px;
    padding: 8px 10px;
}

QListView::item:hover {
    background-color: #123a59;
}

QTableView::item {
    padding: 7px 8px;
}

QTableView::item:selected,
QListView::item:selected {
    background-color: #28b7ff;
    color: #06121d;
}

QHeaderView::section {
    background-color: #102f49;
    border: 0;
    border-right: 1px solid #1e5578;
    border-bottom: 1px solid #1e5578;
    color: #edf7ff;
    padding: 7px 8px;
}

QTableView#peerTelemetryTable {
    background-color: #061827;
    border-color: #28b7ff;
}

QTableView#peerTelemetryTable::item {
    padding: 8px;
}

QScrollBar:vertical,
QScrollBar:horizontal {
    background: #071725;
    border: 0;
    margin: 0;
}

QScrollBar:vertical {
    width: 12px;
}

QScrollBar:horizontal {
    height: 12px;
}

QScrollBar::handle {
    background: #2d6f99;
    border-radius: 6px;
    min-height: 28px;
    min-width: 28px;
}

QScrollBar::handle:hover {
    background: #3f8fbd;
}

QScrollBar::add-line,
QScrollBar::sub-line,
QScrollBar::add-page,
QScrollBar::sub-page {
    background: transparent;
    border: 0;
}

QProgressBar {
    background-color: #071725;
    border: 1px solid #2d6f99;
    border-radius: 7px;
    color: #edf7ff;
    padding: 1px;
    text-align: center;
}

QProgressBar::chunk {
    background-color: #28b7ff;
    border-radius: 6px;
}

QTextEdit#rpcTerminalOutput {
    background-color: #04111d;
    border: 1px solid #28b7ff;
    border-radius: 8px;
    color: #d8f3ff;
    padding: 10px;
    selection-background-color: #28b7ff;
    selection-color: #06121d;
}

QLineEdit#rpcTerminalInput {
    background-color: #071725;
    border: 1px solid #28b7ff;
    border-radius: 7px;
    color: #d8f3ff;
    padding: 8px 10px;
}

QLineEdit#rpcTerminalInput:focus {
    border-color: #8de6ff;
}
