/* Curecoin Dark
   Accent: CureCoin Blue #2eb6e8 */

QWidget {
    background-color: #1a1d21;
    color: #e8eaed;
    selection-background-color: #2eb6e8;
    selection-color: #071014;
}

QMainWindow,
QDialog,
QMenuBar,
QMenu,
QStatusBar,
QToolBar {
    background-color: #1a1d21;
    color: #e8eaed;
}

QMenuBar::item {
    background: transparent;
    padding: 6px 10px;
}

QMenuBar::item:selected,
QMenu::item:selected {
    background-color: #2a3038;
    color: #ffffff;
}

QMenu {
    border: 1px solid #3a3f48;
    border-radius: 6px;
    padding: 4px;
}

QMenu::item {
    padding: 6px 24px 6px 24px;
}

QToolBar {
    border: 0;
    spacing: 6px;
    padding: 6px;
}

QToolBar QToolButton {
    margin: 2px;
    min-height: 34px;
}

QToolBar QToolButton:checked {
    background-color: #193445;
    border-color: #2eb6e8;
    color: #ffffff;
}

QToolBar QToolButton:checked:hover {
    background-color: #21485f;
}

QStatusBar {
    border-top: 1px solid #303640;
}

QLabel#statusPillOk,
QLabel#statusPillWarning,
QLabel#statusPillNeutral {
    border-radius: 9px;
    font-weight: bold;
    padding: 3px 8px;
}

QLabel#statusPillOk {
    background-color: #142a25;
    border: 1px solid #3adc96;
    color: #8dffc8;
}

QLabel#statusPillWarning {
    background-color: #2c2415;
    border: 1px solid #d9a441;
    color: #ffd17a;
}

QLabel#statusPillNeutral {
    background-color: #17232d;
    border: 1px solid #3a5364;
    color: #b5c4cf;
}

QFrame#overviewWalletFrame,
QFrame#overviewRecentFrame,
QFrame[frameShape="6"] {
    background-color: #22262d;
    border: 1px solid #3a3f48;
    border-radius: 8px;
}

QFrame#overviewHeroFrame {
    background: qlineargradient(x1: 0, y1: 0, x2: 1, y2: 1,
                                stop: 0 #101923, stop: 0.45 #162532, stop: 1 #0c1219);
    border: 1px solid #2eb6e8;
    border-radius: 10px;
}

QFrame#overviewMetricCard {
    background-color: #111c26;
    border: 1px solid #2d4656;
    border-radius: 8px;
}

QWidget#overviewNetworkPanel {
    background-color: #07121c;
    border: 1px solid #2eb6e8;
    border-radius: 10px;
}

QLabel {
    background: transparent;
}

QLabel#overviewHeroEyebrow {
    color: #7fd8ff;
    font-weight: bold;
    letter-spacing: 1px;
}

QLabel#overviewHeroCaption,
QLabel#overviewMetricTitle {
    color: #9fb3c1;
}

QLabel#overviewHeroBalance {
    color: #ffffff;
    font-family: "Cascadia Mono", "Consolas", "Monospace";
}

QLabel#overviewHeroSubtitle {
    color: #b5c4cf;
}

QLabel#overviewMetricValue {
    color: #f5fbff;
    font-family: "Cascadia Mono", "Consolas", "Monospace";
}

QLabel#overviewHeroStatusWarning,
QLabel#overviewHeroStatusInfo,
QLabel#overviewHeroStatusOk {
    border-radius: 10px;
    font-weight: bold;
    padding: 4px 10px;
}

QLabel#overviewHeroStatusWarning {
    background-color: #2c1b20;
    border: 1px solid #ff6b6b;
    color: #ff9b9b;
}

QLabel#overviewHeroStatusInfo {
    background-color: #122833;
    border: 1px solid #2eb6e8;
    color: #9ee8ff;
}

QLabel#overviewHeroStatusOk {
    background-color: #142a25;
    border: 1px solid #3adc96;
    color: #8dffc8;
}

QLabel#overviewEmptyState {
    background-color: #111c26;
    border: 1px dashed #2d4656;
    border-radius: 8px;
    color: #9fb3c1;
    padding: 28px;
}

QFrame#transactionsHeroFrame {
    background: qlineargradient(x1: 0, y1: 0, x2: 1, y2: 0,
                                stop: 0 #101923, stop: 1 #172634);
    border: 1px solid #2d4656;
    border-radius: 10px;
}

QLabel#pageHeroEyebrow {
    color: #7fd8ff;
    font-weight: bold;
    letter-spacing: 1px;
}

QLabel#pageHeroSubtitle {
    color: #b5c4cf;
}

QLabel#labelWalletStatus,
QLabel#labelTransactionsStatus,
QLabel#statusLabel {
    color: #ff6b6b;
}

QLabel#labelBalance,
QLabel#labelStake,
QLabel#labelUnconfirmed,
QLabel#labelImmature,
QLabel#labelNumTransactions {
    color: #f5fbff;
    font-family: "Cascadia Mono", "Consolas", "Monospace";
}

QPushButton,
QToolButton {
    background-color: #2a3038;
    border: 1px solid #3f4652;
    border-radius: 6px;
    color: #e8eaed;
    padding: 7px 12px;
}

QPushButton:hover,
QToolButton:hover {
    background-color: #313844;
    border-color: #2eb6e8;
}

QPushButton:pressed,
QToolButton:pressed {
    background-color: #21313a;
}

QPushButton:disabled,
QToolButton:disabled {
    background-color: #20242a;
    color: #7a828e;
    border-color: #303640;
}

QLineEdit,
QComboBox,
QAbstractSpinBox,
QDateTimeEdit {
    background-color: #111418;
    border: 1px solid #3a3f48;
    border-radius: 6px;
    color: #e8eaed;
    padding: 6px 8px;
    selection-background-color: #2eb6e8;
    selection-color: #071014;
}

QLineEdit:focus,
QComboBox:focus,
QAbstractSpinBox:focus,
QDateTimeEdit:focus {
    border-color: #2eb6e8;
}

QScrollArea {
    background-color: #171a1f;
    border: 1px solid #303640;
    border-radius: 8px;
}

QScrollArea > QWidget > QWidget {
    background-color: transparent;
}

QDialog#SendCoinsDialog,
QWidget#AddressBookPage {
    background-color: #1a1d21;
}

QWidget#AddressBookPage QLabel#labelExplanation {
    background-color: #111c26;
    border: 1px solid #2d4656;
    border-radius: 8px;
    color: #b5c4cf;
    padding: 12px;
}

QWidget#AddressBookPage QPushButton {
    min-height: 28px;
}

QDialog#SendCoinsDialog QLabel#labelBalance {
    color: #f5fbff;
    font-family: "Cascadia Mono", "Consolas", "Monospace";
    font-weight: bold;
}

QDialog#SendCoinsDialog QPushButton#sendButton {
    background-color: #14506a;
    border-color: #2eb6e8;
    color: #ffffff;
    font-weight: bold;
    min-height: 30px;
}

QDialog#SendCoinsDialog QPushButton#sendButton:hover {
    background-color: #1f6f91;
}

QFrame#SendCoinsEntry {
    background-color: #111c26;
    border: 1px solid #2d4656;
    border-radius: 8px;
}

QFrame#SendCoinsEntry QLabel {
    color: #b5c4cf;
}

QFrame#SendCoinsEntry QToolButton {
    min-width: 28px;
    padding: 5px;
}

QComboBox::drop-down,
QDateTimeEdit::drop-down {
    border: 0;
    width: 24px;
}

QComboBox QAbstractItemView {
    background-color: #20242a;
    border: 1px solid #3a3f48;
    selection-background-color: #2eb6e8;
    selection-color: #071014;
}

QFrame#transactionFilterFrame {
    background-color: #111c26;
    border: 1px solid #2d4656;
    border-radius: 8px;
    padding: 8px;
}

QDialog#OptionsDialog {
    background-color: #1a1d21;
}

QLabel#settingsHeroEyebrow {
    color: #7fd8ff;
    font-weight: bold;
    letter-spacing: 1px;
}

QLabel#settingsHeroSubtitle {
    color: #b5c4cf;
}

QTabWidget#settingsTabWidget::pane {
    background-color: #111c26;
    border: 1px solid #2d4656;
    border-radius: 10px;
    padding: 10px;
}

QTabWidget#settingsTabWidget QTabBar::tab {
    min-width: 82px;
}

QLabel#settingsStatusLabel {
    color: #ff9b9b;
}

QDialog#OptionsDialog QPushButton#okButton,
QDialog#OptionsDialog QPushButton#applyButton {
    background-color: #14506a;
    border-color: #2eb6e8;
    color: #ffffff;
    font-weight: bold;
}

QDialog#OptionsDialog QPushButton#okButton:hover,
QDialog#OptionsDialog QPushButton#applyButton:hover {
    background-color: #1f6f91;
}

QComboBox#transactionFilterCombo,
QLineEdit#transactionFilterSearch,
QLineEdit#transactionFilterAmount {
    background-color: #071014;
    border-color: #2d4656;
}

QCheckBox,
QRadioButton {
    spacing: 8px;
}

QTabWidget::pane {
    border: 1px solid #3a3f48;
    border-radius: 8px;
    top: -1px;
}

QTabBar::tab {
    background-color: #20242a;
    border: 1px solid #303640;
    border-bottom-color: #3a3f48;
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    padding: 7px 12px;
    margin-right: 2px;
}

QTabBar::tab:selected {
    background-color: #2a3038;
    border-color: #2eb6e8;
    color: #ffffff;
}

QTableView,
QTreeView,
QListView {
    background-color: #171a1f;
    alternate-background-color: #1f242b;
    border: 1px solid #303640;
    border-radius: 8px;
    color: #e8eaed;
    gridline-color: #303640;
}

QListView {
    padding: 6px;
}

QListView::item {
    border-radius: 6px;
    padding: 8px 10px;
}

QListView::item:hover {
    background-color: #242a32;
}

QTableView::item {
    padding: 7px 8px;
}

QTableView::item:selected,
QListView::item:selected {
    background-color: #2eb6e8;
    color: #071014;
}

QHeaderView::section {
    background-color: #22262d;
    border: 0;
    border-right: 1px solid #303640;
    border-bottom: 1px solid #303640;
    color: #e8eaed;
    padding: 7px 8px;
}

QTableView#peerTelemetryTable {
    background-color: #081019;
    border-color: #2eb6e8;
}

QTableView#peerTelemetryTable::item {
    padding: 8px;
}

QTableView#transactionHistoryTable {
    background-color: #0c1219;
    border-color: #2d4656;
}

QTableView#transactionHistoryTable::item {
    padding: 9px 8px;
}

QScrollBar:vertical,
QScrollBar:horizontal {
    background: #15181d;
    border: 0;
    margin: 0;
}

QScrollBar:vertical {
    width: 12px;
}

QScrollBar:horizontal {
    height: 12px;
}

QScrollBar::handle {
    background: #3a3f48;
    border-radius: 6px;
    min-height: 28px;
    min-width: 28px;
}

QScrollBar::handle:hover {
    background: #4a5360;
}

QScrollBar::add-line,
QScrollBar::sub-line,
QScrollBar::add-page,
QScrollBar::sub-page {
    background: transparent;
    border: 0;
}

QProgressBar {
    background-color: #111418;
    border: 1px solid #3a3f48;
    border-radius: 7px;
    color: #e8eaed;
    padding: 1px;
    text-align: center;
}

QProgressBar::chunk {
    background-color: #2eb6e8;
    border-radius: 6px;
}

QTextEdit#rpcTerminalOutput {
    background-color: #050b11;
    border: 1px solid #2eb6e8;
    border-radius: 8px;
    color: #d8f3ff;
    padding: 10px;
    selection-background-color: #2eb6e8;
    selection-color: #071014;
}

QLineEdit#rpcTerminalInput {
    background-color: #071014;
    border: 1px solid #2eb6e8;
    border-radius: 7px;
    color: #d8f3ff;
    padding: 8px 10px;
}

QLineEdit#rpcTerminalInput:focus {
    border-color: #80e2ff;
}
